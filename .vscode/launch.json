        {
            "name": "Setup Electrostatic-Sandbox Workstation",
            "type": "node-terminal",
            "request": "launch",
            "command": "chmod +rwx ./helper-scripts/setup-environment/setup-sandbox.sh && ./helper-scripts/setup-environment/setup-sandbox.sh"
        },
        {
            "name": "User's Permissions Granting",
            "type": "node-terminal",
            "request": "launch",
            "command": "chmod +rwx ./helper-scripts/project-impl/post-compile/post-compile-electrostatic.sh && chmod +rwx ./helper-scripts/project-impl/*.sh && chmod +rwx ./helper-scripts/ci-cd/*.sh"
        },
