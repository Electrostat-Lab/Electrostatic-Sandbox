    \node[block] (validate) [below of=start] {Phase 1: Validate Inputs};
    \node[decision] (valid) [below of=validate] {Valid?};
    \node[process] (init) [below of=valid, xshift=2cm] {Phase 2: Initialize Rotator $R$};
    \node[process] (rotate) [below of=init] {Phase 3: Compute $M_{out} = M_{in} \cdot R$};
    \node[process] (gimbal) [below of=rotate] {Phase 4: Update Gimbal Orientation};
    \node[decision] (lock) [below of=gimbal] {Gimbal Lock?};
    \node[process] (handle) [below of=lock, xshift=2cm] {Phase 5: Handle Gimbal Lock};
    \node[block] (end) [below of=handle] {RETURN: \texttt{PASS}};
    
    % Arrows
    \draw[->] (start) -- (validate);
    \draw[->] (validate) -- (valid);
    \draw[->] (valid) -- node[right] {No} (end);
    \draw[->] (valid) -- node[left] {Yes} (init);
    \draw[->] (init) -- (rotate);
    \draw[->] (rotate) -- (gimbal);
    \draw[->] (gimbal) -- (lock);
    \draw[->] (lock) -- node[left] {Yes} (handle);
    \draw[->] (lock) -- node[right] {No} (end);
    \draw[->] (handle) -- (end);
\end{tikzpicture}
\caption{Algorithmic Flow of \texttt{mat3\_rotate}: Multi-phase state machine for matrix rotation with gimbal lock detection.}
\end{figure}

